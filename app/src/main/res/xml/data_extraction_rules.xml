<?xml version="1.0" encoding="utf-8"?>
<!--
  Nova Store stores a Google Play session token (encrypted, see SessionCipher)
  and the installed-app inventory. None of it must leave the device through a
  cloud backup or a device-to-device transfer, so every domain is excluded.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
